  <diagram id="vSDxvuqvINnKPT_VMfxj" name="payment-gateway">
    <mxGraphModel dx="7512" dy="4060" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="iIMRzTf35lxI4AUppVfz-78" value="" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;glass=0;sketch=1;curveFitting=1;jiggle=2;fillColor=none;strokeColor=#82b366;" parent="1" vertex="1">
          <mxGeometry x="-830" y="1956" width="1794" height="265" as="geometry" />
        </mxCell>
        <mxCell id="iIMRzTf35lxI4AUppVfz-79" value="Happy Case Scenario&lt;div&gt;(POS receives response without retries)&lt;/div&gt;" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;fontColor=#B9E0A5;fontSize=20;" parent="1" vertex="1">
          <mxGeometry x="-1295" y="2036" width="443" height="78" as="geometry" />
        </mxCell>
        <mxCell id="iIMRzTf35lxI4AUppVfz-59" value="" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;glass=0;sketch=1;curveFitting=1;jiggle=2;fillColor=none;strokeColor=#82b366;" parent="1" vertex="1">
          <mxGeometry x="-820" y="2959" width="1794" height="646" as="geometry" />
        </mxCell>
        <mxCell id="iIMRzTf35lxI4AUppVfz-1" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;Functional Requirements&lt;/h1&gt;&lt;p&gt;- The payment gateway should be able to receive transactions from a point-of-sale and securely transfer it to the payment processor.&lt;/p&gt;&lt;p&gt;- The payment gateway should guarantee that a customer is not charged twice for the same service or good. In other words, the requests should be idempotent.&lt;/p&gt;&lt;p&gt;- The payment gateway should use Stripe as a payment processor.&lt;/p&gt;" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;fontSize=20;" parent="1" vertex="1">
          <mxGeometry x="-716" y="-225" width="547" height="361" as="geometry" />
        </mxCell>
        <mxCell id="iIMRzTf35lxI4AUppVfz-5" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;Non-Functional Requirements&lt;/h1&gt;&lt;p&gt;- The payment gateway should choose consistency over availability.&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&amp;nbsp;&lt;/span&gt;&lt;/p&gt;&lt;p&gt;- SLA Availability is 5 nines or 99.999%, which allows at most 5 minutes and 26 seconds of downtime per year.&amp;nbsp;&lt;/p&gt;&lt;p&gt;- The payment gateway should be able to process 10 billion transactions per month, which is 3858 transactions per second.&lt;/p&gt;" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;fontSize=20;" parent="1" vertex="1">
          <mxGeometry x="-129" y="-225" width="547" height="368" as="geometry" />
        </mxCell>
        <mxCell id="iIMRzTf35lxI4AUppVfz-6" value="&lt;div&gt;Stripe API&lt;/div&gt;Gateway" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=default;strokeColor=#82b366;sketch=1;curveFitting=1;jiggle=2;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;fontSize=20;strokeWidth=3;" parent="1" vertex="1">
          <mxGeometry x="3479" y="1483.0000000000002" width="128" height="128" as="geometry" />
        </mxCell>
        <mxCell id="iIMRzTf35lxI4AUppVfz-7" value="&lt;font style=&quot;font-size: 20px;&quot; face=&quot;Comic Sans MS&quot;&gt;Payment&lt;/font&gt;&lt;div&gt;&lt;font style=&quot;font-size: 20px;&quot; face=&quot;Comic Sans MS&quot;&gt;Service&lt;/font&gt;&lt;/div&gt;" style="whiteSpace=wrap;html=1;aspect=fixed;rounded=1;sketch=1;curveFitting=1;jiggle=2;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;fillColor=default;" parent="1" vertex="1">
          <mxGeometry x="3052" y="1090" width="128" height="128" as="geometry" />
        </mxCell>
        <mxCell id="iIMRzTf35lxI4AUppVfz-8" value="&lt;div&gt;Payment Service&lt;/div&gt;DB" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=default;strokeColor=#6c8ebf;fontFamily=Comic Sans MS;sketch=1;curveFitting=1;jiggle=2;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;fontSize=20;strokeWidth=3;" parent="1" vertex="1">
