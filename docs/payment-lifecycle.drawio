        <mxCell id="fM6e5OibFkX16gMwJjKR-7" value="&lt;div&gt;Stripe Checkout&lt;/div&gt;Gateway" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=default;strokeColor=#82b366;sketch=1;curveFitting=1;jiggle=2;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;fontSize=20;strokeWidth=3;" parent="1" vertex="1">
