        <mxCell id="WQVDMI5H9VvCSdu9MSoU-73" value="" style="edgeStyle=none;orthogonalLoop=1;jettySize=auto;html=1;rounded=0;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;fontSize=16;startSize=14;endArrow=open;endSize=14;sourcePerimeterSpacing=8;targetPerimeterSpacing=8;curved=1;sketch=1;curveFitting=1;jiggle=2;strokeWidth=3;" parent="1" edge="1">
          <mxGeometry width="140" relative="1" as="geometry">
            <mxPoint x="878" y="575" as="sourcePoint" />
            <mxPoint x="738" y="575" as="targetPoint" />
            <Array as="points" />
          </mxGeometry>
        </mxCell>
        <mxCell id="WQVDMI5H9VvCSdu9MSoU-74" value="&lt;span style=&quot;&quot;&gt;Acts as a security bridge between the business and the payment processor.&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;fontSize=21;" parent="1" vertex="1">
          <mxGeometry x="903" y="531" width="294" height="99" as="geometry" />
        </mxCell>
        <mxCell id="WQVDMI5H9VvCSdu9MSoU-75" value="&lt;span style=&quot;&quot;&gt;The acquiring bank sends the transaction details through the card network to the issuing bank.&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;fontSize=21;" parent="1" vertex="1">
          <mxGeometry x="1060" y="1500" width="272" height="116" as="geometry" />
        </mxCell>
        <mxCell id="WQVDMI5H9VvCSdu9MSoU-76" value="&lt;span style=&quot;&quot;&gt;The issuing bank sends the authorization response through the card network to the acquiring bank.&lt;/span&gt;" style="text;strokeColor=none;fillColor=none;html=1;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=20;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;" parent="1" vertex="1">
          <mxGeometry x="-25" y="1495" width="287" height="119" as="geometry" />
        </mxCell>
        <mxCell id="WQVDMI5H9VvCSdu9MSoU-77" value="&lt;span style=&quot;&quot;&gt;Authorization response is returned back to the POS (merchant)..&lt;/span&gt;&lt;div style=&quot;&quot;&gt;&lt;br&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;Merchant gathers all the approved transactions for subsequent processing later on.&lt;/div&gt;" style="text;strokeColor=none;fillColor=none;html=1;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=20;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;" parent="1" vertex="1">
          <mxGeometry x="-16" y="651.5" width="265" height="219" as="geometry" />
        </mxCell>
        <mxCell id="WQVDMI5H9VvCSdu9MSoU-78" value="&lt;span style=&quot;&quot;&gt;Payment results are displayed to the customer.&lt;/span&gt;" style="text;strokeColor=none;fillColor=none;html=1;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=20;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;" parent="1" vertex="1">
          <mxGeometry x="57" y="359" width="176" height="73" as="geometry" />
        </mxCell>
        <mxCell id="WQVDMI5H9VvCSdu9MSoU-79" value="" style="edgeStyle=none;orthogonalLoop=1;jettySize=auto;html=1;rounded=0;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;fontSize=16;startSize=14;endArrow=open;endSize=14;sourcePerimeterSpacing=8;targetPerimeterSpacing=8;curved=1;sketch=1;curveFitting=1;jiggle=2;strokeWidth=3;" parent="1" edge="1">
