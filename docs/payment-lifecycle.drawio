        <mxCell id="skso77QOXbakw1OaSZng-48" value="&lt;span&gt;The payment processor validates the batch of authorized transactions. Then it transfers the transaction details to the acquiring bank if it is valid.&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;fontSize=20;" parent="Zg1OTLPi_NNzwxuW0AJh-1" vertex="1">
