            <Array as="points" />
          </mxGeometry>
        </mxCell>
        <mxCell id="WQVDMI5H9VvCSdu9MSoU-57" value="&lt;span style=&quot;&quot;&gt;The payment gateway securely transmits the transaction data to the payment processor.&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;fontSize=21;" parent="1" vertex="1">
