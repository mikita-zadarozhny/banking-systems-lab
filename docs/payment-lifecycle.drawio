        <mxCell id="WQVDMI5H9VvCSdu9MSoU-53" value="&lt;span style=&quot;&quot;&gt;The point-of-sale securely transmits the customer&#39;s payment information to payment gateway.&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;fontSize=21;" parent="1" vertex="1">
          <mxGeometry x="1005" y="354" width="272" height="136" as="geometry" />
        </mxCell>
        <mxCell id="WQVDMI5H9VvCSdu9MSoU-54" value="" style="edgeStyle=none;orthogonalLoop=1;jettySize=auto;html=1;rounded=0;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;fontSize=16;startSize=14;endArrow=open;endSize=14;sourcePerimeterSpacing=8;targetPerimeterSpacing=8;curved=1;sketch=1;curveFitting=1;jiggle=2;strokeWidth=3;" parent="1" edge="1">
