        <mxCell id="YcFtHOd4KzjYWFEnXl1v-60" value="" style="edgeStyle=none;orthogonalLoop=1;jettySize=auto;html=1;rounded=0;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;fontSize=16;startSize=14;endArrow=open;endSize=14;sourcePerimeterSpacing=8;targetPerimeterSpacing=8;curved=1;sketch=1;curveFitting=1;jiggle=2;strokeWidth=3;" parent="1" edge="1">
          <mxGeometry width="140" relative="1" as="geometry">
            <mxPoint x="-338" y="151" as="sourcePoint" />
            <mxPoint x="-478" y="151" as="targetPoint" />
            <Array as="points" />
          </mxGeometry>
        </mxCell>
        <mxCell id="YcFtHOd4KzjYWFEnXl1v-61" value="&lt;span style=&quot;&quot;&gt;Acts as a security bridge between the business and the payment processor.&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;fontSize=21;" parent="1" vertex="1">
          <mxGeometry x="-313" y="107" width="294" height="99" as="geometry" />
        </mxCell>
        <mxCell id="YcFtHOd4KzjYWFEnXl1v-62" value="&lt;span style=&quot;&quot;&gt;The acquiring bank sends the transaction details through the card network to the issuing bank.&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;fontSize=21;" parent="1" vertex="1">
          <mxGeometry x="-156" y="1076" width="272" height="116" as="geometry" />
        </mxCell>
        <mxCell id="YcFtHOd4KzjYWFEnXl1v-63" value="&lt;span style=&quot;&quot;&gt;The issuing bank sends the authorization response through the card network to the acquiring bank.&lt;/span&gt;" style="text;strokeColor=none;fillColor=none;html=1;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=20;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;" parent="1" vertex="1">
          <mxGeometry x="-1241" y="1071" width="287" height="119" as="geometry" />
        </mxCell>
        <mxCell id="YcFtHOd4KzjYWFEnXl1v-64" value="&lt;span style=&quot;&quot;&gt;Authorization response is returned back to the POS (merchant)..&lt;/span&gt;&lt;div style=&quot;&quot;&gt;&lt;br&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;Merchant gathers all the approved transactions for subsequent processing later on.&lt;/div&gt;" style="text;strokeColor=none;fillColor=none;html=1;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=20;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;" parent="1" vertex="1">
          <mxGeometry x="-1232" y="227.5" width="265" height="219" as="geometry" />
        </mxCell>
        <mxCell id="YcFtHOd4KzjYWFEnXl1v-65" value="&lt;span style=&quot;&quot;&gt;Payment results are displayed to the customer.&lt;/span&gt;" style="text;strokeColor=none;fillColor=none;html=1;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=20;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;" parent="1" vertex="1">
          <mxGeometry x="-1159" y="-65" width="176" height="73" as="geometry" />
        </mxCell>
        <mxCell id="YcFtHOd4KzjYWFEnXl1v-66" value="" style="edgeStyle=none;orthogonalLoop=1;jettySize=auto;html=1;rounded=0;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;fontSize=16;startSize=14;endArrow=open;endSize=14;sourcePerimeterSpacing=8;targetPerimeterSpacing=8;curved=1;sketch=1;curveFitting=1;jiggle=2;strokeWidth=3;" parent="1" edge="1">
          <mxGeometry width="140" relative="1" as="geometry">
            <mxPoint x="-1182" y="-182" as="sourcePoint" />
            <mxPoint x="-1042" y="-182" as="targetPoint" />
            <Array as="points" />
          </mxGeometry>
        </mxCell>
        <mxCell id="YcFtHOd4KzjYWFEnXl1v-67" value="&lt;span style=&quot;&quot;&gt;A payment method might be a debit card or a credit card.&lt;/span&gt;" style="text;strokeColor=none;fillColor=none;html=1;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=20;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;" parent="1" vertex="1">
          <mxGeometry x="-1422" y="-230.5" width="220" height="101" as="geometry" />
        </mxCell>
        <mxCell id="YcFtHOd4KzjYWFEnXl1v-68" value="" style="edgeStyle=none;orthogonalLoop=1;jettySize=auto;html=1;rounded=0;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;fontSize=16;startSize=14;endArrow=open;endSize=14;sourcePerimeterSpacing=8;targetPerimeterSpacing=8;curved=1;sketch=1;curveFitting=1;jiggle=2;strokeWidth=3;" parent="1" edge="1">
          <mxGeometry width="140" relative="1" as="geometry">
            <mxPoint x="-972" y="-26" as="sourcePoint" />
            <mxPoint x="-811" y="-70" as="targetPoint" />
            <Array as="points" />
          </mxGeometry>
        </mxCell>
        <mxCell id="YcFtHOd4KzjYWFEnXl1v-69" value="Customer" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;sketch=1;curveFitting=1;jiggle=2;strokeWidth=3;fontSize=20;" parent="1" vertex="1">
          <mxGeometry x="-967" y="-418" width="64" height="128" as="geometry" />
