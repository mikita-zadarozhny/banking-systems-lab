        <mxCell id="iIMRzTf35lxI4AUppVfz-254" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;Payment Service API&lt;/h1&gt;&lt;p&gt;- GET /api/v1/ws - opens a web-socket connection for real-time and bidirectional communication with payment service.&lt;/p&gt;&lt;p&gt;- POST /api/v1/webhook - API endpoint for Stripe to send payment updates.&lt;/p&gt;" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;fontSize=20;" parent="1" vertex="1">
          <mxGeometry x="2270" y="307" width="431" height="236" as="geometry" />
        </mxCell>
        <mxCell id="iIMRzTf35lxI4AUppVfz-263" value="&lt;font style=&quot;font-size: 20px;&quot; face=&quot;Comic Sans MS&quot;&gt;Payment&lt;/font&gt;&lt;div&gt;&lt;font style=&quot;font-size: 20px;&quot; face=&quot;Comic Sans MS&quot;&gt;Service&lt;/font&gt;&lt;/div&gt;" style="whiteSpace=wrap;html=1;aspect=fixed;rounded=1;sketch=1;curveFitting=1;jiggle=2;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;fillColor=default;" parent="1" vertex="1">
          <mxGeometry x="3072" y="1110" width="128" height="128" as="geometry" />
        </mxCell>
        <mxCell id="iIMRzTf35lxI4AUppVfz-273" value="Payment service database might be partitioned:&lt;div&gt;&lt;br&gt;&lt;div&gt;- on client_id, which would allow efficient search of all the payments of some user and the history of the payment, but it would require visiting multiple shards when merchant wants to get all their authorized transactions for settlement.&lt;/div&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;- on merchant_id, which would allow efficient search of all the transactions processed for some merchant_id, but it might result into hot partitions. Also, it would require visiting multiple partitions to get all the payments of some particular client_id.&lt;/div&gt;" style="text;strokeColor=none;fillColor=none;html=1;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=20;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;" parent="1" vertex="1">
          <mxGeometry x="3826" y="2404" width="463" height="384" as="geometry" />
        </mxCell>
        <mxCell id="iIMRzTf35lxI4AUppVfz-274" value="Possible values for phase field are:&amp;nbsp;&lt;div&gt;- CREATED&lt;/div&gt;&lt;div&gt;- REQUEST_SENT_TO_PAYMENT_PROCESSOR&lt;/div&gt;&lt;div&gt;- RECEIVED_RESPONSE_FROM_PAYMENT_PROCESSOR&lt;/div&gt;&lt;div&gt;- SENT_RESPONSE_TO_POS&lt;/div&gt;" style="text;strokeColor=none;fillColor=none;html=1;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=20;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;" parent="1" vertex="1">
          <mxGeometry x="2495" y="3439" width="577" height="138" as="geometry" />
        </mxCell>
        <mxCell id="iIMRzTf35lxI4AUppVfz-278" value="Possible values for status field are:&amp;nbsp;&lt;div&gt;- PENDING&lt;/div&gt;&lt;div&gt;- AUTHORIZED&lt;/div&gt;&lt;div&gt;- FAILED&lt;/div&gt;&lt;div&gt;- SETTLED (Out of scope)&lt;/div&gt;" style="text;strokeColor=none;fillColor=none;html=1;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=20;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;" parent="1" vertex="1">
          <mxGeometry x="2495" y="3213" width="577" height="138" as="geometry" />
        </mxCell>
        <mxCell id="iIMRzTf35lxI4AUppVfz-279" style="edgeStyle=none;curved=1;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;fontSize=16;startSize=14;endArrow=open;endSize=14;sourcePerimeterSpacing=8;targetPerimeterSpacing=8;sketch=1;curveFitting=1;jiggle=2;" parent="1" source="iIMRzTf35lxI4AUppVfz-275" target="iIMRzTf35lxI4AUppVfz-274" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="iIMRzTf35lxI4AUppVfz-280" style="edgeStyle=none;curved=1;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;fontSize=16;startSize=14;endArrow=open;endSize=14;sourcePerimeterSpacing=8;targetPerimeterSpacing=8;sketch=1;curveFitting=1;jiggle=2;" parent="1" source="iIMRzTf35lxI4AUppVfz-164" target="iIMRzTf35lxI4AUppVfz-278" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="iIMRzTf35lxI4AUppVfz-283" value="Payment Service DB" style="text;strokeColor=none;fillColor=none;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=40;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;" parent="1" vertex="1">
          <mxGeometry x="3802" y="2271" width="387" height="114" as="geometry" />
        </mxCell>
        <mxCell id="iIMRzTf35lxI4AUppVfz-284" value="DB&lt;div&gt;(Partition 1)&lt;br&gt;Leader&lt;/div&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=default;strokeColor=#6c8ebf;fontFamily=Comic Sans MS;sketch=1;curveFitting=1;jiggle=2;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;fontSize=20;strokeWidth=3;" parent="1" vertex="1">
          <mxGeometry x="4580" y="2497" width="199" height="187" as="geometry" />
        </mxCell>
        <mxCell id="iIMRzTf35lxI4AUppVfz-285" value="DB&lt;div&gt;(Partition N)&lt;br&gt;Leader&lt;/div&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=default;strokeColor=#6c8ebf;fontFamily=Comic Sans MS;sketch=1;curveFitting=1;jiggle=2;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;fontSize=20;strokeWidth=3;" parent="1" vertex="1">
          <mxGeometry x="4580" y="3154" width="199" height="187" as="geometry" />
        </mxCell>
        <mxCell id="iIMRzTf35lxI4AUppVfz-286" value="DB&lt;div&gt;(Partition 1)&lt;br&gt;Follower 1&lt;/div&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=default;strokeColor=#6c8ebf;fontFamily=Comic Sans MS;sketch=1;curveFitting=1;jiggle=2;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;fontSize=20;strokeWidth=3;" parent="1" vertex="1">
          <mxGeometry x="5006" y="2382" width="199" height="187" as="geometry" />
        </mxCell>
        <mxCell id="iIMRzTf35lxI4AUppVfz-287" value="DB&lt;div&gt;(Partition 1)&lt;br&gt;Follower M&lt;/div&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=default;strokeColor=#6c8ebf;fontFamily=Comic Sans MS;sketch=1;curveFitting=1;jiggle=2;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;fontSize=20;strokeWidth=3;" parent="1" vertex="1">
          <mxGeometry x="5006" y="2622" width="199" height="187" as="geometry" />
        </mxCell>
        <mxCell id="iIMRzTf35lxI4AUppVfz-288" value="DB&lt;div&gt;(Partition N)&lt;br&gt;Follower 1&lt;/div&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=default;strokeColor=#6c8ebf;fontFamily=Comic Sans MS;sketch=1;curveFitting=1;jiggle=2;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;fontSize=20;strokeWidth=3;" parent="1" vertex="1">
          <mxGeometry x="5006" y="3044" width="199" height="187" as="geometry" />
        </mxCell>
        <mxCell id="iIMRzTf35lxI4AUppVfz-289" value="DB&lt;div&gt;(Partition N)&lt;br&gt;Follower M&lt;/div&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=default;strokeColor=#6c8ebf;fontFamily=Comic Sans MS;sketch=1;curveFitting=1;jiggle=2;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;fontSize=20;strokeWidth=3;" parent="1" vertex="1">
          <mxGeometry x="5006" y="3284" width="199" height="187" as="geometry" />
        </mxCell>
        <mxCell id="iIMRzTf35lxI4AUppVfz-291" value="Raft consensus algorithm (data quorum part)&amp;nbsp;&amp;nbsp;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;Durability of the database is achieved by synchronous replication to multiple replicas. A leader sends the newly received data to all the followers, it waits for an acknowledgment from the majority (leader is included), either unavailable or slow nodes from minority may catch up later. Waiting acknowledgement from all the replicas increases latency and reduces availability.&amp;nbsp;&amp;nbsp;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;For example, if cluster consists of 3 databases, then at least 2 (majority, including the leader of the partition) should have the latest copy of the data. For this particular scenario, Leader will send a request to all the databases and will wait a response only from one, why only one? Because altogether with the leader it is 2, which is the majority of the cluster. If the rest of the databases are down, then it won&#39;t disturb the system, as the system may tolerate the downtime of minority of nodes.&amp;nbsp; &amp;nbsp;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;In a nutshell&amp;nbsp;&lt;/div&gt;&lt;div&gt;- Write operation happened.&amp;nbsp;&lt;/div&gt;&lt;div&gt;- Leader stores it into the log.&amp;nbsp;&lt;/div&gt;&lt;div&gt;- Log is replicated to all followers.&amp;nbsp;&lt;/div&gt;&lt;div&gt;- Waiting for acknowledge from the majority.&amp;nbsp;&lt;/div&gt;&lt;div&gt;- Commits entry.&amp;nbsp;&lt;/div&gt;&lt;div&gt;- Lagging followers may catch up later.&lt;/div&gt;" style="text;strokeColor=none;fillColor=none;html=1;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=20;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;" parent="1" vertex="1">
          <mxGeometry x="3826" y="2818" width="541" height="686" as="geometry" />
        </mxCell>
        <mxCell id="iIMRzTf35lxI4AUppVfz-292" value="" style="edgeStyle=none;orthogonalLoop=1;jettySize=auto;html=1;rounded=0;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;fontSize=16;startSize=14;endArrow=open;endSize=14;sourcePerimeterSpacing=8;targetPerimeterSpacing=8;curved=1;sketch=1;curveFitting=1;jiggle=2;strokeWidth=3;" parent="1" edge="1">
          <mxGeometry width="140" relative="1" as="geometry">
            <mxPoint x="4832" y="2635" as="sourcePoint" />
            <mxPoint x="4972" y="2704" as="targetPoint" />
            <Array as="points" />
