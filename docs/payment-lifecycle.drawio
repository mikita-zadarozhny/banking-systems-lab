        <mxCell id="5BBIUFb8RYefbM7r1KL5-2" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;Flow Explanation&lt;/h1&gt;&lt;p&gt;The customer put items into a cart, clicks checkout, payment service creates payment intent and shares it with stripe. then the customer is redirected to stripe checkout page, then pays (it allows to avoid storing card details in the database of a payment gateway). In the end the user is redirected back to the merchant&#39;s site and merchant&#39;s payment service receives a webhook event.&amp;nbsp;&lt;/p&gt;" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;fontSize=20;" vertex="1" parent="1">
          <mxGeometry x="1752" y="307" width="431" height="351" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
