        <mxCell id="WQVDMI5H9VvCSdu9MSoU-59" value="&lt;span style=&quot;&quot;&gt;The payment processor validates the received information. Then it transfers the transaction details to the acquiring bank if it is valid.&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;fontSize=21;" parent="1" vertex="1">
